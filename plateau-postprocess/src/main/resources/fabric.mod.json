{
  "schemaVersion": 1,
  "id": "plateau-postprocess",
  "version": "${version}",

  "name": "plateau-postprocess",
  "description": "Some abstract for make postprocess shader for plateau",
  "authors": ["MrSypz"],
  "contact": {},

  "license": "All-Rights-Reserved",
  "icon": "assets/plateau-postprocess/icon.png",

  "environment": "client",
  "entrypoints": {
    "client": ["com.sypztep.plateauPostprocess.client.PlateauPostprocessClient"]
